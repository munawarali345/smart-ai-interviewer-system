# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub!

# ============================================================
# MongoDB Connection
# ============================================================
# Local MongoDB (Docker) - Use this format:
# MONGO_URI=mongodb://localhost:27017/YOUR_DATABASE_NAME

# MongoDB Atlas (Cloud) - Use this format:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/YOUR_DATABASE_NAME

# Example (replace with your own):
MONGO_URI=mongodb://localhost:27017/YOUR_DATABASE_NAME # for compass

# ============================================================
# Grok AI API Key
# ============================================================
# Get your API key from https://x.ai or Groq console
GROK_API_KEY=your_grok_api_key_here

# ============================================================
# Optional Configuration
# ============================================================
# Next.js App URL (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
